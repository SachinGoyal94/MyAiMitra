# Backend service URLs used by the frontend.
# Copy this file to .env.local and fill in real values.
# Note: NEXT_PUBLIC_ vars are inlined into the client bundle at build time,
# so they must be set in the environment before running `next build`.

NEXT_PUBLIC_DB_CHAT_URL=https://your-db-chat-backend.example.com
NEXT_PUBLIC_SUMMARIZER_URL=https://your-summarizer-backend.example.com
NEXT_PUBLIC_FLOWCHART_URL=https://your-flowchart-backend.example.com
NEXT_PUBLIC_COURSE_GUIDANCE_URL=https://your-course-guidance-backend.example.com
NEXT_PUBLIC_PERSONA_FLOW_URL=https://your-persona-flow-backend.example.com
NEXT_PUBLIC_MAIN_APP_URL=https://your-main-app-backend.example.com
